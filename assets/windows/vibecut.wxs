<?xml version="1.0" encoding="UTF-8"?>
<!--
  VibeCut's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.8 -d Root=C:\...\VibeCut
              -d Stage=C:\...\stage\VibeCut-0.2.8-windows-x86_64
              -o stage\VibeCut-0.2.8-windows-x86_64.msi assets\windows\vibecut.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="VibeCut"
           Manufacturer="VibeCut"
           Version="$(var.Version)"
           UpgradeCode="837393F2-DE58-4A01-8B3A-9776839DDFDE"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of VibeCut is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="vibecut.ico" SourceFile="$(var.Root)\assets\icons\vibecut.ico" />
    <Property Id="ARPPRODUCTICON" Value="vibecut.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/OscarGallardo35/VibeCut" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="VibeCut" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="VibeCut" />
    </StandardDirectory>

    <Feature Id="Main" Title="VibeCut" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="2F0B7C51-6E4D-4A1B-9C3E-8D5F1A2B3C44">
      <Shortcut Id="StartMenuShortcut"
                Name="VibeCut"
                Description="Video editor"
                Target="[INSTALLFOLDER]vibecut.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="vibecut.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="VibeCut (safe graphics)"
                Description="VibeCut, drawn in software"
                Target="[INSTALLFOLDER]vibecut.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="vibecut.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\VibeCut" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
