# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=vibecut
pkgver=${VIBECUT_VERSION:?VIBECUT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/OscarGallardo35/VibeCut"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${VIBECUT_STAGE:?VIBECUT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/vibecut" "$pkgdir/opt/vibecut/vibecut"
  install -d "$pkgdir/opt/vibecut/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/vibecut/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/vibecut/vibecut "$@"\n' > "$pkgdir/usr/bin/vibecut"
  chmod 755 "$pkgdir/usr/bin/vibecut"
  install -Dm644 "$stage/vibecut.desktop" "$pkgdir/usr/share/applications/vibecut.desktop"
  sed -i 's|^Exec=vibecut|Exec=/opt/vibecut/vibecut %U|' "$pkgdir/usr/share/applications/vibecut.desktop"
  install -Dm644 "$stage/vibecut.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/vibecut.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/vibecut/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/vibecut/THIRD_PARTY_NOTICES.md"
}
